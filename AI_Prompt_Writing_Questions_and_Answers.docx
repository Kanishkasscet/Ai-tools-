.wps-component-float-window .wps-component-float-window-item.transition { display: inline-flex; animation: 8s ease 0s 1 normal none running floatwindow; }

.wps-component-float-window .wps-component-float-window-item .float-window-item-arrow { position: absolute; width: 0px; height: 0px; bottom: -1em; border-width: 0.5em; border-style: solid; border-color: rgba(0, 0, 0, 0.7) transparent transparent; border-image: none; left: 2.5em; }

