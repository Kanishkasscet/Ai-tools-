@keyframes delete { 
  0% { top: 60px; }
  25% { top: 120px; }
  50% { top: 180px; }
  100% { top: 240px; }
}

@keyframes add { 
  0% { top: -120px; }
  10% { top: -108px; }
  20% { top: -96px; }
  30% { top: -84px; }
  40% { top: -72px; }
  50% { top: -60px; }
  60% { top: -48px; }
  70% { top: -36px; }
  80% { top: -24px; }
  90% { top: -12px; }
  100% { top: 0px; }
}

.wps-comment-item { padding: 0px 10px; background: rgb(255, 255, 255); position: relative; font-weight: 400; }

.wps-comment-item.comment-detail { overflow: hidden auto; height: 100%; }

