  0% { opacity: 1; }
  50% { opacity: 0; }
  100% { opacity: 1; }
}

.kd-markdown .kd-markdown__content.disabled a, .kd-markdown .kd-markdown__content.disabled sup { cursor: not-allowed; opacity: 0.42; }

.kd-markdown__refs { margin-top: 20px; }

.kd-markdown__refs-title { font-family: "PingFang SC", sans-serif; font-size: 14px; font-weight: 400; line-height: 24px; color: var(--kd-color-text-primary,hsla(0,0%,5%,.9)); text-align: left; }

[dir="rtl"] .kd-markdown__refs-title { text-align: right; }

.kd-markdown__refs-content { display: flex; padding-top: 8px; flex-wrap: wrap; gap: 8px; }

.kd-markdown__refs-item-arrow { width: 28px; display: flex; height: 28px; cursor: pointer; background: var(--kd-color-line-light,rgb(13 13 2.16666667%)); border-radius: 4px; justify-content: center; align-items: center; }

.kd-markdown__refs-item-arrow .kd-icon { font-size: 16px; }

.kd-markdown__refs-item-arrow:active, .kd-markdown__refs-item-arrow:hover { background-color: rgba(var(--kd-color-blue-2),1); }

.kd-markdown__refs-item-arrow.kd-markdown__refs-item--blue-2-rgb:active, .kd-markdown__refs-item-arrow.kd-markdown__refs-item--blue-2-rgb:hover { background-color: var(--kd-color-blue-2); }

.kd-markdown__refs-item-arrow .kd-color-icon-primary { fill: var(--kd-color-icon-public); stroke: var(--kd-color-icon-public); }

.kd-markdown__refs-item.link { box-sizing: border-box; padding: 0px 8px; font-family: "PingFang SC", sans-serif; font-size: 14px; font-weight: 400; line-height: 22px; color: var(--kd-color-text-public,#1e5fc7); text-align: left; gap: 8px; display: flex; height: 28px; cursor: pointer; background: var(--kd-color-line-light,rgb(13 13 2.16666667%)); border-radius: 4px; justify-content: center; align-items: center; }

[dir="rtl"] .kd-markdown__refs-item.link { text-align: right; }

.kd-markdown__refs-item.link:active, .kd-markdown__refs-item.link:hover { background-color: rgba(var(--kd-color-blue-2),1); }

.kd-markdown__refs-item.link.kd-markdown__refs-item--blue-2-rgb:active, .kd-markdown__refs-item.link.kd-markdown__refs-item--blue-2-rgb:hover { background-color: var(--kd-color-blue-2); }

.kd-markdown__refs-item.link.kd-markdown__refs-item--disabled { color: var(--kd-color-text-tertiary,hsla(0,0%,5%,.46)); text-decoration: none; cursor: not-allowed; background: var(--kd-color-line-light,hsla(0,0%,5%,.06)); }

.kd-markdown--hidden { display: none; }

.kd-skeleton { display: block; width: 100%; height: 32px; padding: 0px; background-color: var(--kd-color-state-hover); border-radius: var(--kd-border-radius-middle); }

.kd-skeleton-loading { background: linear-gradient(90deg,var(--kd-color-state-hover) 25%,var(--kd-color-state-pressed) 37%,var(--kd-color-state-hover) 63%); animation: 1.4s ease 0s infinite normal none running kd-skeleton-loading-ltr; }

[dir="rtl"] .kd-skeleton-loading { background: linear-gradient(-90deg,var(--kd-color-state-hover) 25%,var(--kd-color-state-pressed) 37%,var(--kd-color-state-hover) 63%); animation: 1.4s ease 0s infinite normal none running kd-skeleton-loading-rtl; }

[dir] .kd-skeleton-loading { background-size: 400% 100%; }

.kd-skeleton-title { width: 240px; height: 32px; }

.kd-skeleton-image { width: 120px; height: 120px; }

.kd-skeleton-image-circle { width: 48px; height: 48px; border-radius: 50%; }

.kd-skeleton-button { width: 108px; height: 32px; }

.kd-skeleton-paragraphs .kd-skeleton-paragraph { width: 100%; height: 22px; }

.kd-skeleton-paragraphs .kd-skeleton-paragraph:last-child { width: 50%; }

.kd-skeleton-paragraphs .kd-skeleton-paragraph + .kd-skeleton-paragraph { margin-top: 12px; }

@keyframes kd-skeleton-loading-ltr { 
  0% { background-position: 100% 50%; }
  100% { background-position: 0px 50%; }
}

@keyframes kd-skeleton-loading-rtl { 
  0% { background-position: 0px 50%; }
  100% { background-position: 100% 50%; }
}

@keyframes fillAnimation { 
  0% { fill: var(--kd-color-state-hover); }
  100% { fill: var(--kd-color-state-pressed); }
}

.kd-skeleton-file { display: inline-block; width: 28px; height: 32px; }

.kd-skeleton-file svg { width: 100%; height: 100%; }

.kd-skeleton-file svg path { fill: var(--kd-color-state-hover); }

.kd-skeleton-file path { animation: 1.5s ease 0s infinite normal none running fillAnimation; }

.ai-summary-copy-menu { cursor: pointer; }

.ai-summary-copy-menu .kd-menu { width: 140px; }

.ai-summary-copy-menu-anchor { position: fixed; width: 0px; height: 0px; pointer-events: none; }

.kd-dropdown-button .kd-icon { transition: transform 0.3s; transform: rotate(180deg); }

[dir="rtl"] .kd-dropdown-button .kd-icon { transform: rotate(-180deg); }

.kd-dropdown-button .kd-icon.is-reverse { transform: rotate(0deg); }

ul { padding: 0px; margin: 0px; list-style: none; }

.kd-menu { position: relative; padding: 8px; background: var(--kd-color-background-top); border: 1px solid var(--kd-color-line-regular); box-shadow: var(--kd-box-shadow-large); border-radius: 8px; }

.kd-menu ul { height: 100%; padding-right: 8px; }

[dir="rtl"] .kd-menu ul { padding-right: 0px; padding-left: 8px; }

.kd-menu:focus-visible { outline: none; }

.kd-menu-divider { height: 1px; margin: 4px 0px; background-color: var(--kd-color-line-regular); }

.kd-menu-checkable, .kd-menu-selectable { cursor: pointer; }

.kd-menu .kd-menu-submenu-item { padding-right: 40px; padding-left: 8px; }

[dir="rtl"] .kd-menu .kd-menu-submenu-item { padding-left: 40px; padding-right: 8px; }

.kd-menu-selectable .kd-menu-item { padding: 5px 8px 5px 32px; }

[dir="rtl"] .kd-menu-selectable .kd-menu-item { padding: 5px 32px 5px 8px; }

.kd-menu-item { position: relative; display: flex; padding: 5px 8px; margin-bottom: 4px; font-size: var(--kd-font-size-sub-base); font-weight: var(--kd-font-weight-regular); line-height: var(--kd-font-line-height-base); color: var(--kd-color-text-primary); white-space: nowrap; border-radius: 6px; align-items: flex-start; user-select: none; }

.kd-menu-item-content { overflow: hidden; text-overflow: ellipsis; white-space: normal; }

.kd-menu-item:last-child { margin-bottom: 0px; }

.kd-menu-item-open, .kd-menu-item:hover { background: var(--kd-color-state-hover); }

.kd-menu-item:active { background: var(--kd-color-state-pressed); }

.kd-menu-item.only-text { line-height: 22px; }

.kd-menu-item-disabled { cursor: not-allowed; opacity: 0.3; }

.kd-menu-item-disabled:hover { background: transparent; }

.kd-menu-item-disabled > .kd-checkbox { pointer-events: none; }

.kd-menu-item .kd-menu-item-icon { position: relative; top: 4px; margin-right: 6px; }

[dir="rtl"] .kd-menu-item .kd-menu-item-icon { margin-right: 0px; margin-left: 6px; }

.kd-menu-item .kd-menu-item-suffixicon { position: absolute; top: 16px; right: 8px; width: 16px; height: 16px; margin-top: -8px; }

[dir="rtl"] .kd-menu-item .kd-menu-item-suffixicon { right: auto; left: 8px; }

.kd-menu-item .kd-menu-item-tick { position: absolute; top: 16px; left: 14px; width: 16px; height: 16px; margin-top: -8px; font-size: 16px; }

[dir="rtl"] .kd-menu-item .kd-menu-item-tick { left: auto; right: 14px; }

.kd-menu-item .kd-menu-item-tick .kd-color-icon-primary { fill: var(--kd-color-icon-public); stroke: var(--kd-color-icon-public); }

.kd-menu-item .kd-menu-item-arrow { color: var(--kd-color-icon-secondary); }

.kd-menu-item .component-input-number { position: relative; margin-left: 10px; }

[dir="rtl"] .kd-menu-item .component-input-number { margin-left: 0px; margin-right: 10px; }

.kd-menu-item::after { top: calc(50% - 8px); }

.kd-menu-item .kd-checkbox { top: 1px; width: 14px; margin-right: 6px; }

[dir="rtl"] .kd-menu-item .kd-checkbox { margin-right: 0px; margin-left: 6px; }

.kd-menu-submenu-item { display: flex; align-items: center; }

.kd-menu-group-title { padding: 8px 8px 2px; font-size: var(--kd-font-size-sub-base); font-weight: var(--kd-font-weight-bold); line-height: var(--kd-font-line-height-base); color: var(--kd-color-text-primary); }

.kd-menu .kd-scrollbar-track-horizontal { display: none; }

[dir="rtl"] .kd-menu .kd-menu-arrow, [dir="rtl"] .kd-menu .kd-menu-item-arrow { transform: scaleX(-1); }

.kd-menu-inline { box-sizing: border-box; padding: 0px 16px 12px; background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; box-shadow: none; border-radius: 0px; }

.kd-menu-inline ul { height: auto; padding-right: 0px; }

[dir="rtl"] .kd-menu-inline ul { padding-right: 0px; padding-left: 0px; }

.kd-menu-inline .kd-menu-submenu-inline { list-style: none; }

.kd-menu-inline .kd-menu-submenu-inline > .kd-menu-submenu-title { display: flex; align-items: center; min-height: 32px; padding: 4px 4px 4px 8px; margin-bottom: 4px; font-size: var(--kd-font-size-base); font-weight: var(--kd-font-weight-regular); line-height: 24px; color: var(--kd-color-text-primary); white-space: nowrap; cursor: pointer; border-radius: 6px; user-select: none; }

[dir="rtl"] .kd-menu-inline .kd-menu-submenu-inline > .kd-menu-submenu-title { padding: 4px 8px 4px 4px; }

.kd-menu-inline .kd-menu-submenu-inline > .kd-menu-submenu-title .kd-menu-item-icon { display: flex; width: 16px; height: 16px; margin-right: 8px; align-items: center; justify-content: center; flex-shrink: 0; }

[dir="rtl"] .kd-menu-inline .kd-menu-submenu-inline > .kd-menu-submenu-title .kd-menu-item-icon { margin-right: 0px; margin-left: 8px; }

.kd-menu-inline .kd-menu-submenu-inline > .kd-menu-submenu-title .kd-menu-item-icon svg { width: 16px; height: 16px; }

.kd-menu-inline .kd-menu-submenu-inline > .kd-menu-submenu-title .kd-menu-item-content { display: flex; flex: 1 1 0%; align-items: center; min-height: 24px; padding: 2px 0px; overflow: hidden; text-overflow: ellipsis; }

.kd-menu-inline .kd-menu-submenu-inline > .kd-menu-submenu-title:hover { background: var(--kd-color-state-hover); }

.kd-menu-inline .kd-menu-submenu-inline > .kd-menu-submenu-title:active { background: var(--kd-color-state-pressed); }

.kd-menu-inline .kd-menu-submenu-inline.kd-menu-submenu-has-selected > .kd-menu-submenu-title { color: var(--kd-color-text-public); }

.kd-menu-inline .kd-menu-submenu-inline.kd-menu-submenu-has-selected > .kd-menu-submenu-title .kd-menu-item-icon { color: var(--kd-color-icon-public); }

.kd-menu-inline .kd-menu-submenu-inline.kd-menu-submenu-has-selected > .kd-menu-submenu-title .kd-menu-item-icon .kd-color-icon-primary { fill: currentcolor; stroke: currentcolor; }

.kd-menu-inline .kd-menu-submenu-inline .kd-menu-submenu-arrow { flex-shrink: 0; margin-left: auto; color: var(--kd-color-icon-secondary); transition: transform 0.25s; }

[dir="rtl"] .kd-menu-inline .kd-menu-submenu-inline .kd-menu-submenu-arrow { margin-left: 0px; margin-right: auto; }

.kd-menu-inline .kd-menu-submenu-inline.kd-menu-submenu-inline-open > .kd-menu-submenu-title .kd-menu-submenu-arrow { transform: rotate(180deg); }

[dir="rtl"] .kd-menu-inline .kd-menu-submenu-inline.kd-menu-submenu-inline-open > .kd-menu-submenu-title .kd-menu-submenu-arrow { transform: rotate(-180deg); }

.kd-menu-inline .kd-menu-submenu-inline.kd-menu-item-disabled > .kd-menu-submenu-title { cursor: not-allowed; opacity: 0.3; }

.kd-menu-inline .kd-menu-submenu-inline.kd-menu-item-disabled > .kd-menu-submenu-title:hover { background: transparent; }

.kd-menu-inline .kd-menu-submenu-inline > .kd-menu-submenu-inline-list { height: 0px; padding: 0px; margin: 0px; overflow: hidden; list-style: none; }

.kd-menu-inline .kd-menu-item-selected { overflow: hidden; color: var(--kd-color-text-public); }

.kd-menu-inline .kd-menu-item-selected, .kd-menu-inline .kd-menu-item-selected:hover { background: var(--kd-color-state-pressed-public); }

.kd-menu-inline .kd-menu-item { align-items: center; min-height: 32px; padding: 4px 4px 4px 8px; font-size: var(--kd-font-size-base); line-height: 24px; }

[dir="rtl"] .kd-menu-inline .kd-menu-item { padding: 4px 8px 4px 4px; }

.kd-menu-inline .kd-menu-item .kd-menu-item-icon { top: 0px; display: flex; width: 16px; height: 16px; margin-right: 8px; color: var(--kd-color-icon-primary); align-items: center; justify-content: center; }

[dir="rtl"] .kd-menu-inline .kd-menu-item .kd-menu-item-icon { margin-right: 0px; margin-left: 8px; }

.kd-menu-inline .kd-menu-item .kd-menu-item-icon .kd-color-icon-primary { fill: currentcolor; stroke: currentcolor; }

.kd-menu-inline .kd-menu-item .kd-menu-item-icon svg { width: 16px; height: 16px; }

.kd-menu-inline .kd-menu-item .kd-menu-item-content { display: flex; flex: 1 1 0%; align-items: center; min-height: 24px; padding: 2px 0px; }

.kd-menu-inline .kd-menu-item.kd-menu-item-selected .kd-menu-item-icon { color: var(--kd-color-icon-public); }

.kd-scrollbar-track-vertical { position: absolute; top: 0px; right: 0px; bottom: 0px; width: 6px; border-radius: 3px; }

[dir="rtl"] .kd-scrollbar-track-vertical { right: auto; left: 0px; }

.kd-scrollbar-thumb-horizontal, .kd-scrollbar-thumb-vertical { background: var(--kd-color-fill-heavy); border-radius: 6px; }

.kd-scrollbar-thumb-horizontal:active, .kd-scrollbar-thumb-horizontal:hover, .kd-scrollbar-thumb-vertical:active, .kd-scrollbar-thumb-vertical:hover { background: var(--kd-color-fill-extra-heavy); }

.kd-scrollbar-track-horizontal { position: absolute; right: 0px; bottom: 0px; left: 0px; height: 6px; border-radius: 3px; }

.kd-checkbox { display: inline-flex; min-height: 20px; line-height: 20px; color: var(--kd-color-text-primary); white-space: normal; user-select: none; align-items: flex-start; }

.kd-checkbox, .kd-checkbox-input { position: relative; cursor: pointer; }

.kd-checkbox-input { top: 3.5px; display: flex; white-space: nowrap; vertical-align: middle; outline: none; align-self: flex-start; }

.kd-checkbox-input.is-disabled .kd-checkbox-inner { cursor: not-allowed; background-color: var(--kd-color-fill-light); border-color: var(--kd-color-line-light); }

.kd-checkbox-input.is-disabled .kd-checkbox-inner::after { cursor: not-allowed; border-color: var(--kd-color-icon-white); }

.kd-checkbox-input.is-disabled .kd-checkbox-inner + .kd-checkbox-label { cursor: not-allowed; }

.kd-checkbox-input.is-disabled.is-checked .kd-checkbox-inner, .kd-checkbox-input.is-disabled.is-indeterminate .kd-checkbox-inner { opacity: var(--kd-opacity-disabled); }

.kd-checkbox-input.is-disabled + .kd-checkbox-label { color: var(--kd-color-text-disable); cursor: not-allowed; }

.kd-checkbox-input.is-checked .kd-checkbox-inner { background-color: var(--kd-color-public-normal); border-color: transparent; }

.kd-checkbox-input.is-checked .kd-checkbox-inner::after { transform: rotate(45deg) scaleY(1); }

.kd-checkbox-input.is-checked .kd-checkbox-inner:hover { background-color: var(--kd-color-public-hover); }

.kd-checkbox-input.is-focus .kd-checkbox-inner { border-color: var(--kd-color-public-hover); }

.kd-checkbox-input.is-indeterminate .kd-checkbox-inner { background-color: var(--kd-color-public-normal); border-color: transparent; }

.kd-checkbox-input.is-indeterminate .kd-checkbox-inner::before { position: absolute; top: 50%; right: 3px; left: 3px; display: block; margin-top: -1px; content: ""; border-top: 2px solid var(--kd-color-icon-white); }

.kd-checkbox-input.is-indeterminate .kd-checkbox-inner::after { display: none; }

.kd-checkbox-inner { position: relative; display: inline-block; width: 14px; height: 14px; background-color: var(--kd-color-fill-base); border-radius: var(--kd-border-radius-extra-small); border: 1px solid var(--kd-color-line-heavy); box-sizing: border-box; transition: border-color 0.25s cubic-bezier(0.71, -0.46, 0.29, 1.46), background-color 0.25s cubic-bezier(0.71, -0.46, 0.29, 1.46); }

.kd-checkbox-inner:hover { background-color: var(--kd-color-state-hover); }

.kd-checkbox-inner::after { position: absolute; top: 1px; left: 4px; width: 3px; height: 6px; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; content: ""; transform: rotate(45deg) scaleY(0); box-sizing: content-box; border-left: 0px; border-top: 0px; transition: transform 0.15s cubic-bezier(0.71, -0.46, 0.88, 0.6) 0.05s; transform-origin: center center; }

.kd-checkbox-original { position: absolute; left: -9999px; margin: 0px; outline: none; opacity: 0; visibility: hidden; size: 0px; }

