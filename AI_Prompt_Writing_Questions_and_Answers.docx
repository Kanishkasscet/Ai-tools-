.kd-markdown .kd-markdown__content.stream-cursor .colorful-box { display: inline-block !important; }

.kd-markdown .kd-markdown__content .colorful-box { position: relative; display: none; width: 2px; height: 1em; }

.kd-markdown .kd-markdown__content .colorful-box .colorful-cursor { position: absolute; top: 0.2em; display: inline-block; width: 100%; height: 100%; margin-left: 0.2em; background: linear-gradient(0deg, rgb(255, 217, 172), rgb(226, 102, 197) 38.13%, rgb(100, 106, 247)); border-radius: var(--Border-Radius-kd-border-radius-50,2px); animation: 1s ease 0s infinite normal none running van-cursor-flicker; }

