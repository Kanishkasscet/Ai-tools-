@charset "utf-8";

:root { color: rgba(13, 13, 13, 0.898); font-synthesis: none; text-rendering: optimizelegibility; -webkit-font-smoothing: antialiased; --color-primary: #4285f4; --color-muted: #0d0d0da8; --color-border: #0d0d0d0f; background: rgb(247, 247, 247); font-family: "Noto Sans", "Segoe UI", Avenir, Helvetica, Arial, sans-serif; }

* { box-sizing: border-box; }

body { min-width: 320px; margin: 0px; }

button, input, select, textarea { font: inherit; }

a, button, input { -webkit-tap-highlight-color: transparent; }

button { cursor: pointer; }

button:disabled { cursor: not-allowed; opacity: 0.55; }

a { color: var(--color-primary); }

:focus-visible { outline-offset: 3px; outline: rgb(138, 166, 255) solid 3px; }

img { max-width: 100%; }

.app-shell { min-height: 100dvh; }

.error-page { text-align: center; max-width: 640px; margin-inline: auto; padding: 80px 24px; }

.error-page button { color: rgb(255, 255, 255); background: var(--color-primary); border: 0px; border-radius: 10px; padding: 12px 24px; }

.brand { font-size: 22px; font-weight: 700; }

.button { border: 1px solid rgba(0, 0, 0, 0); border-radius: 8px; padding: 12px 25px; font-weight: 500; transition: background-color 0.15s; }

.button-primary { background: var(--color-primary); color: rgb(255, 255, 255); }

.button-primary:hover:not(:disabled) { background: rgb(87, 144, 255); }

.button-primary:active:not(:disabled) { background: rgb(45, 115, 255); }

.button-outline { color: var(--color-primary); background: rgb(255, 255, 255); border-color: rgb(202, 212, 239); }

.text-button { color: var(--color-primary); text-underline-offset: 3px; background: 0px 0px; border: 0px; padding: 0px; text-decoration: underline; }

.status-message { text-align: center; color: rgb(116, 121, 138); font-size: 13px; line-height: 1.8; }

.file-name { overflow-wrap: anywhere; unicode-bidi: plaintext; }

.multiline { white-space: pre-line; }

.sr-only { clip: rect(0px, 0px, 0px, 0px); white-space: nowrap; border: 0px; width: 1px; height: 1px; margin: -1px; padding: 0px; position: absolute; overflow: hidden; }

@media (prefers-reduced-motion: reduce) {
  *, ::after, ::before { scroll-behavior: auto !important; transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
}
