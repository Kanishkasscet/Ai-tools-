.component-bottom-dialog .bottom-dialog-body.new-layout-need-safe-bottom { padding-bottom: var(--safe-bottom); }

.component-bottom-dialog .component-panel-item { background: rgb(255, 255, 255); flex-shrink: 0; }

.history-version-toast-container { display: flex; align-items: center; }

.history-version-toast-container .history-version-toast-btn .kd-button { line-height: 24px; }

.history-version-toast-container .history-version-toast-btn .kd-button .kd-button-children { height: 24px; font-size: 12px; }

.history-version-notice { position: relative; top: -4px; padding-right: 3px; }

.history-version-notice-content { font-size: 14px; padding-right: 5px; }

.history-version-notice-content .normal-text { color: rgba(13, 13, 13, 0.9); font-size: 14px; line-height: 22px; }

.history-version-notice-content .bold-name { font-weight: 500; margin-right: 6px; }

.history-version-notice-content .avatar { position: relative; top: 4px; width: 20px; height: 20px; border-radius: 50%; margin-left: 6px; margin-right: 4px; overflow: hidden; }

.history-version-notice-content .default_avatar { top: -2px !important; }

.history-version-notice-bottom { display: flex; align-items: center; justify-content: flex-end; margin-top: 12px; }

.history-version-notice-bottom .history-btn { color: var(--kd-color-text-public,#1e5fc7); text-align: center; font-size: 14px; font-weight: 600; line-height: 22px; margin-right: 26px; }

.history-version-notice-bottom .close-icon { width: 12px; height: 12px; }

.mobile-header-right-insert { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100px; margin-left: 8px; }

