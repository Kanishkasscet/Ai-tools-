.ai-summary-content { position: relative; margin-top: 12px; color: var(--kd-color-text-primary,hsla(0,0%,5%,.9)); font-size: var(--kd-font-size-basee,14px); overflow-y: auto; flex: 1 1 0%; }

.ai-summary-pc .ai-summary-content::-webkit-scrollbar-track { background: transparent !important; }

.ai-summary-pc .ai-summary-content::-webkit-scrollbar-thumb { border-color: transparent !important; }

.ai-summary-content .colorful-box { position: relative; display: inline-block; width: 2px; height: 1em; }

.ai-summary-content .colorful-box .colorful-cursor { position: absolute; top: 0.2em; display: inline-block; width: 100%; height: 100%; margin-left: 0.2em; background: linear-gradient(0deg, rgb(255, 217, 172), rgb(226, 102, 197) 38.13%, rgb(100, 106, 247)); border-radius: 2px; animation: 1s ease 0s infinite normal none running van-cursor-flicker; }

@keyframes van-cursor-flicker { 
  0% { opacity: 1; }
  50% { opacity: 0; }
  100% { opacity: 1; }
}

.ai-summary-content-loading { margin-top: 12px; flex: 1 1 0%; overflow: hidden; }

.ai-summary-content-loading .kd-skeleton-paragraphs .kd-skeleton { height: 12px; border-radius: 2px; }

.ai-summary-content-loading .kd-skeleton-paragraphs .kd-skeleton-paragraph + .kd-skeleton-paragraph { margin-top: 16px; }

.long-press-popover-container { display: contents; }

.long-press-popover-anchor { position: fixed; width: 0px; height: 0px; pointer-events: none; }

.long-press-popover { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 12px; box-shadow: rgba(9, 23, 49, 0.21) 0px 2px 6px 0px; }

.long-press-popover.kd-popover { border-radius: 12px; }

.long-press-popover .kd-popover-content { padding: 0px; }

.long-press-popover .ai-summary-menu { display: flex; align-items: flex-start; max-width: 90vw; padding: 0px 10px; overflow-x: auto; }

.long-press-popover .ai-summary-menu::-webkit-scrollbar { display: none; }

.long-press-popover .ai-summary-menu-item { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; box-sizing: border-box; min-width: 48px; padding: 11px 0px; color: var(--kd-color-text-primary,hsla(0,0%,5%,.9)); }

.long-press-popover .ai-summary-menu-item-text { margin-top: 5px; padding: 0px 4px; font-size: 11px; text-align: center; word-break: break-word; overflow-wrap: anywhere; }

.ai-summary-content .colorful-box { position: relative; display: inline-block; width: 2px; height: 1em; }

.ai-summary-content .colorful-box .colorful-cursor { position: absolute; top: 0.2em; display: inline-block; width: 100%; height: 100%; margin-left: 0.2em; background: linear-gradient(0deg, rgb(255, 217, 172), rgb(226, 102, 197) 38.13%, rgb(100, 106, 247)); border-radius: 2px; animation: 1s ease 0s infinite normal none running van-cursor-flicker; }

.ai-summary-mobile .ai-summary-content { position: relative; flex: 1 1 auto; min-height: 0px; overflow: hidden auto; width: calc(100% + 6px); padding-right: 6px; margin-top: 12px; color: var(--kd-color-text-primary,hsla(0,0%,5%,.9)); font-size: 14px; user-select: none; touch-action: pan-x pan-y; scrollbar-color: var(--kd-color-fill-heavy,#dbdbdb) transparent; }

.ai-summary-mobile .ai-summary-content::-webkit-scrollbar { width: 6px; }

.ai-summary-mobile .ai-summary-content::-webkit-scrollbar-thumb { border-radius: 6px; background: var(--kd-color-fill-heavy,#dbdbdb); }

.ai-summary-mobile .ai-summary-content.contextmenu { border-radius: 2px; background: var(--kd-color-state-pressed,hsla(0,0%,5%,.1)); }

.ai-summary-mobile .ai-summary-content-loading { flex: 1 1 auto; min-height: 0px; margin-top: 12px; overflow: hidden; }

.ai-summary-mobile .ai-summary-content-loading .kd-skeleton-paragraphs .kd-skeleton { height: 12px; border-radius: 2px; }

.ai-summary-mobile .ai-summary-content-loading .kd-skeleton-paragraphs .kd-skeleton-paragraph + .kd-skeleton-paragraph { margin-top: 16px; }

.ai-summary-mobile .ai-summary-content-loading .kd-skeleton-paragraphs .kd-skeleton-paragraph:last-child { width: 170px; }

.ai-summary-mobile .ai-summary-menu-popover { cursor: pointer; }

@keyframes van-cursor-flicker { 
  0% { opacity: 1; }
  50% { opacity: 0; }
  100% { opacity: 1; }
}

.ai-summary-footer-divider { flex: 0 0 auto; height: 1px; background: var(--kd-color-line-regular,hsla(0,0%,5%,.12)); margin: 8px 0px 7px; }

.ai-summary-footer { flex: 0 0 auto; display: inline-flex; justify-content: space-between; align-items: center; column-gap: 8px; width: 100%; font-size: var(--kd-font-size-sub-base); line-height: var(--kd-font-size-extra-large); }

.ai-summary-footer .left, .ai-summary-footer .right { display: inline-flex; align-items: center; gap: 0px; }

.ai-summary-footer .left { min-width: 0px; }

.ai-summary-footer .left .hint { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--kd-font-size-small,12px); color: var(--kd-color-text-tertiary); line-height: var(--kd-font-line-height-small,20px); }

.ai-summary-footer .primary-fill .kd-color-icon-blue-primary { fill: var(--kd-color-icon-primary); stroke: var(--kd-color-icon-primary); }

.ai-summary-pc .ai-summary-pc-card { width: 100%; display: flex; flex-direction: column; max-height: 256px; }

.ai-summary-pc .ai-summary-pc-card.fixed-height { height: 256px; }

.ai-summary-mobile .ai-summary-mobile-card { display: flex; flex: 1 1 auto; flex-direction: column; min-height: 0px; width: calc(100% + 6px); padding-right: 6px; overflow: hidden; }

.ai-summary-mobile .ai-summary-mobile-card .ai-summary-header, .ai-summary-mobile .ai-summary-mobile-card .ai-summary-max-word-count-tip-mobile { flex: 0 0 auto; }

.ai-summary-mobile .ai-summary-mobile-card .ai-summary-mobile-error { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 4px; margin-top: 8px; color: var(--kd-color-text-secondary); font-size: var(--kd-font-size-sub-base,13px); line-height: var(--kd-font-line-height-small,20px); }

.ai-summary-mobile .ai-summary-mobile-card .ai-summary-mobile-error .kd-icon { font-size: 16px; }

.ai-summary-pc { position: relative; width: 100%; height: 100%; padding: 11px 15px; margin-top: 8px; background: var(--kd-color-fill-base,#fff); border: 1px solid var(--kd-color-line-light,hsla(0,0%,5%,.06)); border-radius: 8px; font-family: "PingFang SC"; cursor: auto; }

.ai-summary-pc .ai-summary-content { width: calc(100% + 15px); }

.ai-summary-pc .ai-summary-content .ai-summary-scrollbar-inner { padding-right: 15px; }

.w-eye-protect-mode .ai-summary-pc { background: inherit; }

.text-link-btn { display: inline-flex !important; height: 22px; }

.text-link-btn .kd-button { height: 22px; color: var(--kd-color-text-public,#1e5fc7); }

.ai-summary-mobile { position: relative; box-sizing: border-box; display: flex; flex-direction: column; width: 100%; touch-action: pan-x pan-y; max-height: 360px; overflow: hidden; padding: 11px 15px; margin-top: 4px; background: var(--kd-color-fill-base,#fff); border: 1px solid var(--kd-color-line-light,hsla(0,0%,5%,.06)); border-radius: 8px; font-family: "PingFang SC"; cursor: auto; }

.page-related-top-container.mobile-mode .ai-summary-mobile { width: auto; margin-left: 16px; margin-right: 16px; }

.ai-summary-mobile:has(.ai-summary-mobile-card.fixed-height) { height: 360px; }

.page-related-top-container { box-sizing: border-box; pointer-events: auto; position: absolute; top: 0px; left: 0px; z-index: 2; transform-origin: left top; }

.animation-fade-in-left { animation: 0.2s ease 0s 1 normal none running fadeInLeft; }

@keyframes fadeInLeft { 
  0% { opacity: 0; transform: translate3d(100%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

.red-split .kd-color-icon-green-primary { fill: var(--kd-color-icon-red-primary); stroke: var(--kd-color-icon-red-primary); }

.primary-fill .kd-color-icon-secondary { fill: var(--kd-color-icon-primary); stroke: var(--kd-color-icon-primary); }

.secondary-fill .kd-color-icon-primary { fill: var(--kd-color-icon-secondary); stroke: var(--kd-color-icon-secondary); }

.white-fill .kd-color-icon-primary { fill: var(--kd-color-icon-white); stroke: var(--kd-color-icon-white); }

.warn-lock .kd-color-icon-primary { fill: var(--kd-color-icon-warning); stroke: var(--kd-color-icon-warning); }

.blue-symbol-cross .kd-color-icon-primary { fill: var(--kd-color-icon-info); stroke: var(--kd-color-icon-info); }

.blue-success-normal .kd-color-icon-success { fill: rgb(var(--kd-color-blue-5)); stroke: rgb(var(--kd-color-blue-5)); }

@font-face { font-family: "Wps Emoji"; src: url("../../../fonts/iconfont.b0069a1e.ttf") format("truetype"); }

html, html body { overflow: hidden; }

html body { font-family: BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, "PingFang SC", "Microsoft Yahei", "Hiragino Sans GB", sans-serif, "Wps Emoji", "apple color emoji", "Noto Color Emoji", "segoe ui emoji", "segoe ui symbol"; text-size-adjust: 100% !important; }

.mobile.wps-preview { cursor: auto; user-select: auto; }

.mobile.wps-preview.no-copy { user-select: none; }

.mobile.wps-preview.no-copy .preview-page-container { position: relative; }

.mobile.wps-preview.no-copy .preview-page-container .no-copy-box { position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; }

.mobile .content-container { display: flex; flex-direction: column; }

.mobile .edit-area { flex-grow: 1; overflow: hidden; background-color: rgb(255, 255, 255); margin-bottom: env(safe-area-inset-bottom); }

.mobile .edit-area #template-background-wrapper { position: fixed; inset: 0px; }

.mobile .edit-area #workspace.writer-container { position: relative; display: inline-block; overflow: hidden; z-index: 1; min-width: 100vw; top: 44px; }

.mobile .edit-area #workspace.writer-container.is-history { top: 0px; }

.mobile .edit-area #workspace.writer-container.card-mode { top: 0px !important; }

.mobile .edit-area #workspace.writer-container.pagination-mode { background-color: rgb(242, 244, 247); overflow-x: scroll; }

.mobile .edit-area #workspace.writer-container .doc-pending-canvas-unit { display: none; }

.mobile .edit-area .m-coop-container { z-index: 200; }

.mobile .edit-area #div_writer_grid { position: absolute; inset: 40px 0px 0px; overflow: hidden; width: 100%; height: calc(100% - 40px); }

.mobile .edit-area .wps-font-download-notification { z-index: 1000; }

.mobile .edit-area #workspace .wps-page-container .canvas-unit .page-num { position: absolute; bottom: 5px; left: 5px; z-index: 10000; background: rgb(77, 77, 77); color: rgb(231, 231, 231); font-size: 12px; height: 16px; line-height: 16px; border-radius: 2px; display: flex; align-items: center; justify-content: space-around; min-width: 24px; }

.mobile .edit-area #workspace .wps-page-container .canvas-unit .page-number-hidden { display: none !important; }

.mobile [data-dpr="2"] .dpr-border-top, [data-dpr="3"] .mobile .dpr-border-top { border-top-width: 0.5px !important; }

.mobile [data-dpr="2"] .dpr-border-left, [data-dpr="3"] .mobile .dpr-border-left { border-left-width: 0.5px !important; }

.mobile [data-dpr="2"] .dpr-border-right, [data-dpr="3"] .mobile .dpr-border-right { border-right-width: 0.5px !important; }

.mobile [data-dpr="2"] .dpr-border-bottom, [data-dpr="3"] .mobile .dpr-border-bottom { border-bottom-width: 0.5px !important; }

.mobile [data-dpr="2"] .dpr-border, [data-dpr="3"] .mobile .dpr-border { border-width: 0.5px !important; }

.mobile .avatar-item.editting .avatar-item-icon { opacity: 1; }

.mobile .avatar-item .avatar-item-icon { position: absolute; width: 8px; height: 8px; right: -2px; bottom: -2px; border-radius: 4px; opacity: 0; }

.xc-preview-container { position: fixed; height: 100%; width: 100%; display: flex; flex-direction: column; overflow: auto; }

.xc-preview-container .preview-page-container { transform-origin: left top; overflow: scroll; flex-grow: 1; height: 100%; }

.xc-preview-container .preview-page-container .pages-list { transform-origin: left top; transform: scale(1); text-align: center; padding-bottom: 20px; min-height: 101%; }

.xc-preview-container .preview-page-container .pages-list .page { position: relative; overflow: hidden; display: inline-block; background-color: rgb(255, 255, 255); box-shadow: rgba(157, 160, 164, 0.4) 0px 2px 12px 0px; margin: 20px 10px 0px; }

.xc-preview-container .preview-page-container .pages-list .page.unvisible svg { display: none; }

.xc-preview-container .preview-page-container .pages-list .page .page-num { position: absolute; bottom: 5px; left: 5px; z-index: 10000; background: rgb(77, 77, 77); color: rgb(231, 231, 231); font-size: 12px; height: 16px; line-height: 16px; border-radius: 2px; display: flex; align-items: center; justify-content: space-around; min-width: 24px; }

.component-notice .component-notice-content .notice-content .function-limit-notice-content-guide { text-decoration: underline; }

.vertical-center { display: flex; align-items: center; }

.horizontal-center { display: flex; justify-content: center; }

.notice-body { font-size: 12px; }

.page-outside-container { width: 100%; position: absolute; top: 3000px; }

.page-top-container { position: absolute; top: 0px; left: 0px; width: 0px; height: 0px; z-index: 2; pointer-events: none; }

.page-top-container .page-related-top-container { pointer-events: auto; }

.more-menus-component-panel.component-half-screen-panel .panel-body .panel-content { touch-action: pan-x pan-y; }

#workspace image { image-rendering: var(--wps-image-rendering,crisp-edges); }

