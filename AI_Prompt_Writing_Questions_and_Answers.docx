.kd-modal-root .kd-modal-confirm-header { display: flex; margin: 10px 0px 20px; align-items: baseline; }

.kd-modal-root .kd-modal-confirm-icon { align-items: center; margin-right: 8px; }

[dir="rtl"] .kd-modal-root .kd-modal-confirm-icon { margin-right: 0px; margin-left: 8px; }

.kd-modal-root .kd-modal-confirm-icon .kd-icon { vertical-align: text-bottom; }

.kd-modal-root .kd-modal-confirm-title { font-size: var(--kd-font-size-sub-base); font-weight: 600; line-height: 24px; }

.kd-modal-root .kd-modal-confirm-content { font-size: var(--kd-font-size-sub-base); font-weight: 400; line-height: 20px; }

.kd-modal-root .kd-modal-sm { width: calc(480px * var(--kd-modal-i18n-zoom)); }

.kd-modal-root .kd-modal-md { width: calc(640px * var(--kd-modal-i18n-zoom)); }

.kd-modal-root .kd-modal-lg { width: calc(800px * var(--kd-modal-i18n-zoom)); }

.kd-modal-root .kd-modal.fade-appear-active, .kd-modal-root .kd-modal.fade-enter-active { animation: 0.3s ease 0s 1 normal forwards running fadeIn; }

.kd-modal-root .kd-modal.fade-exit-active { animation: 0.3s ease 0s 1 normal forwards running fadeOut; }

.kd-modal-root .kd-modal.bounce-appear-active, .kd-modal-root .kd-modal.bounce-enter-active { animation: 0.3s ease 0s 1 normal forwards running bounceIn; }

.kd-modal-root .kd-modal.bounce-exit-active { animation: 0.3s ease 0s 1 normal forwards running bounceOut; }

.kd-modal-body::-webkit-scrollbar, .kd-modal-confirm-content::-webkit-scrollbar { width: 6px; }

.kd-modal-body::-webkit-scrollbar-thumb, .kd-modal-confirm-content::-webkit-scrollbar-thumb { background: var(--kd-color-fill-heavy); border-radius: 10px; }

@keyframes fadeIn { 
  0% { opacity: 0; transform: translate3d(0px, -20px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@keyframes fadeOut { 
  0% { opacity: 1; transform: translateZ(0px); }
  100% { opacity: 0; transform: translate3d(0px, -20px, 0px); }
}

@keyframes bounceIn { 
  0% { opacity: 0; transform: scale3d(0.3, 0.3, 0.3); }
  100% { opacity: 1; transform: scaleX(1); }
}

@keyframes bounceOut { 
  0% { opacity: 1; transform: scaleX(1); }
  100% { opacity: 0; transform: scale3d(0.3, 0.3, 0.3); }
}
