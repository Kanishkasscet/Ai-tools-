.wps-reading-mode-toolbar .reading-mode-toolbar-comment-item { position: relative; padding: 0px !important; }

.wps-reading-mode-toolbar .reading-mode-toolbar-comment-item .toolbar-comment-number { position: absolute; top: 0px; left: calc(50% + 10px); font-size: 11px; min-height: 16px; min-width: 16px; line-height: 16px; border-radius: 8px; color: rgb(255, 255, 255); background: rgb(73, 145, 242); padding: 0px 4px; text-align: center; }

.wps-reading-mode-toolbar .wps_typo_web_mode.selected .bar-item-content { background: rgb(233, 236, 240); }

.wps-reading-mode-toolbar .tool-menu-item-tooltip { position: absolute; white-space: nowrap; height: 34px; top: -44px; left: 15px; display: flex; padding: 6px 12px; align-items: flex-start; border-radius: 8px; background: var(---kd-color-feedback-regular,#575757); color: var(---kd-color-inverse-base,#fff); font-size: 14px; font-style: normal; font-weight: 400; line-height: 22px; }

