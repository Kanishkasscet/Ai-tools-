.kd-component-block-btn.btn-theme-o.active, .kd-component-block-btn.btn-theme-o.selected, .kd-component-block-btn.btn-theme-o:active { background: rgb(118, 99, 221); }

.kd-component-block-btn.btn-theme-unknown { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(255, 255, 255); background: rgb(65, 127, 249); }

.kd-component-block-btn.btn-theme-unknown.active, .kd-component-block-btn.btn-theme-unknown.selected, .kd-component-block-btn.btn-theme-unknown:active { background: rgb(58, 114, 223); }

.btn-type-secondary { background-color: var(--kd-color-state-hover,hsla(0,0%,5%,.06)); color: var(--kd-color-text-primary,hsla(0,0%,5%,.9)); }

.btn-type-primary { background-color: var(--kd-color-public-normal,#1f69e0); color: var(--kd-color-text-white,#fff); }

.btn-size-x-large { height: 48px; border-radius: 12px; font-size: 16px; padding: 12px 20px; }

.btn-size-x-large.loading .kd-icon-loading_white { margin-right: 8px; }

.kd-icon-rtl-mirror.kd-icon-dir-rtl svg { transform: scaleX(-1); }

.kd-icon-rtl-variant { --kd-visibility-dir-ltr: visible; --kd-visibility-dir-rtl: hidden; }

.kd-icon-rtl-variant.kd-icon-dir-rtl { --kd-visibility-dir-ltr: hidden; --kd-visibility-dir-rtl: visible; }

.kd-icon-rtl-variant.kd-icon-dir-ltr { --kd-visibility-dir-ltr: visible; --kd-visibility-dir-rtl: hidden; }

[dir="rtl"] .kd-icon-rtl-mirror:not(.kd-icon-dir-ltr):not(.kd-icon-dir-rtl) svg { transform: scaleX(-1); }

[dir="rtl"] .kd-icon-rtl-variant:not(.kd-icon-dir-ltr):not(.kd-icon-dir-rtl) { --kd-visibility-dir-ltr: hidden; --kd-visibility-dir-rtl: visible; }

.kd-component-confirm { position: fixed; z-index: 1010; inset: 0px; padding-bottom: 5%; display: flex; justify-content: center; align-items: center; }

.kd-component-confirm .confirm-dialog-title { font-size: 18px; font-weight: 600; color: var(--kd-color-text-primary,hsla(0,0%,5%,.9)); line-height: 30px; padding-top: 24px; padding-left: 24px; padding-right: 24px; text-align: center; }

.kd-component-confirm::before { content: ""; position: absolute; inset: 0px; z-index: -1; background: var(--kd-color-mask-regular,hsla(0,0%,5%,.5)); }

.kd-component-confirm .confirm-body { width: 320px; display: flex; flex-direction: column; background: rgb(255, 255, 255); box-shadow: rgba(9, 23, 49, 0.21) 0px 2px 6px 0px; border-radius: 16px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; text-align: justify; }

.kd-component-confirm .confirm-content { flex-grow: 1; position: relative; padding: 24px 24px 0px; font-size: 15px; white-space: pre-wrap; word-break: break-word; }

.kd-component-confirm .confirm-content--hastitle { line-height: 24px; padding-top: 8px; color: var(--kd-color-text-secondary,hsla(0,0%,5%,.66)); }

.kd-component-confirm .confirm-content.only-text { text-align: left; display: flex; justify-content: center; }

.kd-component-confirm .confirm-content input { word-break: normal; }

.kd-component-confirm .confirm-footer { padding: 24px; position: relative; display: flex; align-items: center; justify-content: space-between; }

.kd-component-confirm .confirm-footer .kd-component-text-btn { width: 100%; }

.kd-component-confirm .confirm-footer.space-average { display: flex; flex-flow: row-reverse wrap; gap: 12px; }

.kd-component-confirm .confirm-footer.space-average .kd-component-text-btn { flex: 1 1 auto; min-width: calc(50% - 6px); max-width: 100%; width: auto; white-space: nowrap; }
