.wps-comment-item.comment-detail-inScrollBar .scrollbar-inner-wrapper { width: 100% !important; height: auto !important; }

.wps-comment-item.delete-animation { transform: translate3d(0px, 100%, 0px); transition: transform 0.4s ease-out; }

.wps-comment-item.add-animation { animation: 0.5s ease 0s 1 normal none running add; transition: none; }

.wps-comment-item .none { display: none; }

.wps-comment-item .comment-list-header { display: flex; justify-content: space-between; padding-bottom: 9px; margin-top: 9px; }

