.component-segment-btn .segment-item.active, .component-segment-btn .segment-item.selected, .component-segment-btn .segment-item:active { background: rgb(233, 236, 240); }

.component-segment-btn.s .segment-item.active, .component-segment-btn.s .segment-item.selected, .component-segment-btn.s .segment-item:active { background: var(--kd-color-state-pressed); }

.component-segment-btn.k .segment-item.selected { background: var(--kd-color-state-pressed-brand); color: var(--kd-color-text-brand); }

