.wps-component-float-window .wps-component-float-window-item .float-comment-voice .icons { height: 1.538em; width: 1.538em; margin-right: 0.615em; }

.animation-fade-in-left { animation: 0.2s ease 0s 1 normal none running fadeInLeft; }

@keyframes fadeInLeft { 
  0% { opacity: 0; transform: translate3d(100%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

.wps-reading-mode-toolbar { background-color: rgb(255, 255, 255); transform: translateY(0px); transition: transform 0.3s linear; min-height: 59px; }

.wps-reading-mode-toolbar.hidden { display: flex !important; transform: translateY(200px); }

