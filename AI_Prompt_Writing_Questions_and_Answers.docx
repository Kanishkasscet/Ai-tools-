@charset "utf-8";

p[data-v-5ee4685f] { margin: 0px; }

.panel-notice[data-v-5ee4685f] { color: rgb(107, 90, 47); background: rgb(255, 248, 222); margin: 12px 0px; padding: 10px 12px; font-size: 13px; line-height: 20px; }

.old-content[data-v-5ee4685f] { color: rgb(83, 82, 82); text-align: center; margin: 12px 0px 24px; font-size: 14px; font-weight: 500; line-height: 20px; }

.buttons[data-v-5ee4685f] { gap: 15px; display: flex; }

.buttons a[data-v-5ee4685f], .buttons button[data-v-5ee4685f] { cursor: pointer; font: inherit; border: 0px; flex: 1 1 0%; }

.buttons a[data-v-5ee4685f] { justify-content: center; align-items: center; text-decoration: none; display: inline-flex; }

.old-buttons a[data-v-5ee4685f], .old-buttons button[data-v-5ee4685f] { border-radius: 24px; height: 44px; font-size: 14px; line-height: 20px; }

.primary[data-v-5ee4685f] { color: rgb(255, 255, 255); background: rgb(65, 127, 249); font-weight: 700 !important; }

.buttons .secondary[data-v-5ee4685f] { color: rgba(0, 0, 0, 0.6); background: rgb(255, 255, 255); border: 1px solid rgba(0, 0, 0, 0.2); font-weight: 500; }

.install-top[data-v-5ee4685f] { height: 36px; }

.gp .install-top[data-v-5ee4685f] { border-block: 1px solid rgb(222, 222, 222); }

.install-content[data-v-5ee4685f] { flex-direction: column; gap: 24px; padding: 0px 24px 24px; display: flex; }

.gp .install-content[data-v-5ee4685f] { padding-top: 24px; }

.app-info[data-v-5ee4685f] { align-items: center; gap: 16px; display: flex; }

.app-logo[data-v-5ee4685f] { flex-shrink: 0; width: 64px; height: 64px; }

.app-details[data-v-5ee4685f] { flex-direction: column; gap: 6px; display: flex; }

.app-details h3[data-v-5ee4685f] { color: rgb(29, 27, 32); letter-spacing: 0.15px; margin: 0px; font-size: 20px; font-weight: 500; line-height: 24px; }

.app-meta[data-v-5ee4685f] { color: rgb(73, 69, 79); align-items: center; gap: 12px; font-size: 12px; line-height: 16px; display: flex; }

.app-meta span[data-v-5ee4685f] { align-items: center; display: inline-flex; }

.app-meta img[data-v-5ee4685f] { width: 16px; height: 16px; }

.verified[data-v-5ee4685f] { color: rgb(1, 135, 95); align-items: center; gap: 4px; font-size: 10px; font-weight: 500; line-height: 16px; display: flex; }

.verified img[data-v-5ee4685f] { width: 12px; height: 13px; }

.features[data-v-5ee4685f] { scrollbar-width: none; gap: 10px; min-width: 0px; display: flex; overflow: auto hidden; }

.features img[data-v-5ee4685f] { object-fit: cover; border-radius: 8px; flex-shrink: 0; width: 96px; height: 170px; }

.install-description[data-v-5ee4685f] { color: rgb(73, 69, 79); font-size: 12px; line-height: 16px; }

.install-buttons[data-v-5ee4685f] { gap: 12px; }

.install-buttons a[data-v-5ee4685f], .install-buttons button[data-v-5ee4685f] { border-radius: 5px; height: 32px; padding: 4px 15px; font-size: 14px; line-height: 22px; font-weight: 400 !important; }

