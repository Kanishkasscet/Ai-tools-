@media (any-hover: none) {
  .kd-button-primary:hover { background: var(--kd-color-public-normal); }
  .kd-button-primary.is-active, .kd-button-primary:active { background: var(--kd-color-public-pressed); }
  .kd-button-primary.kd-button-danger:hover { background: var(--kd-color-error-normal); }
  .kd-button-primary.kd-button-danger.is-active, .kd-button-primary.kd-button-danger:active { background: var(--kd-color-error-pressed); }
  .kd-button-secondary:hover { background: var(--kd-color-fill-base); }
  .kd-button-secondary:active { background: var(--kd-color-fill-regular); }
  .kd-button-secondary.is-active { color: var(--kd-color-text-primary); background: var(--kd-color-fill-light); }
  .kd-button-secondary.kd-button-highlight { color: var(--kd-color-text-public); }
  .kd-button-secondary.kd-button-highlight.is-active { color: var(--kd-color-text-public); background: var(--kd-color-state-pressed-public); }
  .kd-button-secondary.kd-button-highlight:hover { background: var(--kd-color-fill-base); }
  .kd-button-secondary.kd-button-highlight:active { background: var(--kd-color-fill-regular); }
  .kd-button-secondary.kd-button-danger:hover { background: var(--kd-color-fill-base); }
  .kd-button-secondary.kd-button-danger:active { background: var(--kd-color-fill-regular); }
  .kd-button-secondary.kd-button-danger.is-active { color: var(--kd-color-error-normal); }
  .kd-button-light:hover { background: transparent; }
  .kd-button-light:active { background: var(--kd-color-state-pressed); }
  .kd-button-light.is-active { color: var(--kd-color-text-primary); background-color: var(--kd-color-state-pressed); }
  .kd-button-light.kd-button-highlight:hover { background: transparent; }
  .kd-button-light.kd-button-highlight:active { background: var(--kd-color-state-pressed); }
  .kd-button-light.kd-button-highlight.is-active { color: var(--kd-color-text-public); background-color: var(--kd-color-state-pressed-public); }
  .kd-button-light.kd-button-danger:hover { background: transparent; }
  .kd-button-light.kd-button-danger:active { background: var(--kd-color-state-pressed); }
}

.kd-icon-loading, .kd-icon-loading_white { animation: 0.8s linear 0s infinite normal none running spinning-ltr; }

[dir="rtl"] .kd-icon-loading, [dir="rtl"] .kd-icon-loading_white { animation: 0.8s linear 0s infinite normal none running spinning-rtl; }

.kd-icon-loading_white svg, .kd-icon-loading svg { animation: auto ease 0s 1 normal none running none !important; }

.kd-icon-loading.kd-icon-loading-comp .kd-stroke-width-icon-regular, .kd-icon-loading_white.kd-icon-loading-comp .kd-stroke-width-icon-regular { stroke-width: 2px; }

@keyframes spinning-ltr { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1turn); }
}

@keyframes spinning-rtl { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(-1turn); }
}

.kd-icon { display: inline-block; color: inherit; font-style: normal; line-height: 0; text-align: center; text-transform: none; text-rendering: optimizelegibility; -webkit-font-smoothing: antialiased; }

.kd-icon-spin svg { animation: 1s linear 0s infinite normal none running kd-icon-spin; }

.kd-icon-rtl-mirror.kd-icon-dir-rtl svg { transform: scaleX(-1); }

.kd-icon-rtl-variant { --kd-visibility-dir-ltr: visible; --kd-visibility-dir-rtl: hidden; }

.kd-icon-rtl-variant.kd-icon-dir-rtl { --kd-visibility-dir-ltr: hidden; --kd-visibility-dir-rtl: visible; }

.kd-icon-rtl-variant.kd-icon-dir-ltr { --kd-visibility-dir-ltr: visible; --kd-visibility-dir-rtl: hidden; }

[dir="rtl"] .kd-icon-rtl-mirror:not(.kd-icon-dir-ltr):not(.kd-icon-dir-rtl) svg { transform: scaleX(-1); }

[dir="rtl"] .kd-icon-rtl-variant:not(.kd-icon-dir-ltr):not(.kd-icon-dir-rtl) { --kd-visibility-dir-ltr: hidden; --kd-visibility-dir-rtl: visible; }

@keyframes kd-icon-spin { 
  100% { transform: rotate(1turn); }
}

.kd-icon { display: inline-block; font-size: 0px; line-height: 1; vertical-align: middle; background-repeat: no-repeat; background-size: 100% 100%; flex-shrink: 0; }

@keyframes spinning-ltr { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1turn); }
}

@keyframes spinning-rtl { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(-1turn); }
}

.qq-browser-header { position: absolute; top: 0px; left: 0px; width: 100vw; height: 40px; line-height: 40px; font-size: 14px; background: rgb(246, 246, 246); border-bottom: 1px solid rgb(221, 221, 221); z-index: 2; }

.qq-browser-header .exit { padding-left: 12px; }

.qq-browser-header .undo { position: absolute; right: 64px; height: 40px; line-height: 40px; }

.qq-browser-header .save { position: absolute; right: 12px; height: 40px; line-height: 40px; color: rgb(73, 145, 242); }

.is-page-mode { background: rgb(242, 244, 247); }

.fullscreen-adaptor { position: fixed; bottom: 0px; left: 0px; width: 100vw; background: rgb(255, 255, 255); z-index: 1; height: env(safe-area-inset-bottom,0); }

.scrollbar-outer-wrapper { position: absolute; inset: 0px; z-index: 1; }

.scrollbar-outer-wrapper .scrollbar-inner-wrapper { position: relative; display: inline-block; top: 0px; left: 0px; overflow: hidden; }

.scrollbar-outer-wrapper .scroll-bar { z-index: 100; }

.scrollbar-outer-wrapper .scroll-bar.hide { opacity: 0; }

.scrollbar-outer-wrapper .scroll-bar-x { position: absolute; left: 0px; bottom: 5px; height: 4px; opacity: 0.7; }

.scrollbar-outer-wrapper .scroll-bar-x::before { display: block; content: ""; width: calc(100% - 4px); height: 100%; margin: 0px 2px; background: rgb(193, 193, 193); border-radius: 2px; }

.scrollbar-outer-wrapper .scroll-bar-y { position: absolute; top: 0px; right: 4px; width: 20px; opacity: 0.7; }

.scrollbar-outer-wrapper .scroll-bar-y::before { display: block; content: ""; width: 6px; height: calc(100% - 4px); margin: 2px 0px 2px 14px; background: rgb(193, 193, 193); border-radius: 2px; }

.scrollbar-outer-wrapper .scroll-bar-y:not(.scrollbar-outer-wrapper .scroll-bar-y.highlight)::before { background: var(--kd-color-fill-heavy,#dbdbdb); }

.scrollbar-outer-wrapper .scroll-bar-y.highlight::before { background: var(--kd-color-fill-extra-heavy,#ccc); }

.animation-fade-in-left { animation: 0.2s ease 0s 1 normal none running fadeInLeft; }

@keyframes fadeInLeft { 
  0% { opacity: 0; transform: translate3d(100%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

#guide_container { position: absolute; bottom: 56px; max-height: 100px; width: 100%; z-index: 2; transform: translateY(0px); transition: transform 0.3s linear; }

#guide_container.hide { display: none; }

#guide_container.fade { transform: translateY(200px) !important; }

.animation-fade-in-left { animation: 0.2s ease 0s 1 normal none running fadeInLeft; }

@keyframes fadeInLeft { 
  0% { opacity: 0; transform: translate3d(100%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

#top-banner { position: fixed; top: 48px; width: 100%; height: 0px; max-height: 100px; z-index: 2; transform: translateY(0px); transition: transform 0.3s linear; }

#top-banner.hide { display: none; }

#top-banner.fade { transform: scale(0) !important; }

.wps-context-menu { max-width: 520px; padding: 0px; box-shadow: rgba(13, 13, 13, 0.2) 0px 16px 48px 0px; }

.wps-context-menu.component-context-menu { overflow: hidden; padding: 0px; z-index: 999; }

.wps-context-menu.component-context-menu.hide { display: none; }

.wps-context-menu.component-context-menu .context-menu-container { width: 100%; }

.wps-context-menu.component-context-menu .context-menu-container .context-menu-item { flex-shrink: 0; height: 44px; min-width: 48px; }

.wps-context-menu.component-context-menu .context-menu-container .context-menu-item .menu-content .menu-text { white-space: nowrap; }

