.kd-button-group .kd-button { margin-right: -1px; }

.kd-button-group .kd-button + .kd-button { margin-left: 0px; }

.kd-button-group .kd-button:first-child { border-top-right-radius: 0px; border-bottom-right-radius: 0px; }

.kd-button-group .kd-button:last-child { margin-right: 0px; border-top-left-radius: 0px; border-bottom-left-radius: 0px; }

