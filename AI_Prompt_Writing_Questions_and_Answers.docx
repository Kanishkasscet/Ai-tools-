@keyframes floatwindow { 
  0% { opacity: 0; }
  15% { opacity: 1; }
  63% { opacity: 1; }
  68% { opacity: 0; }
  100% { opacity: 0; }
}

.wps-component-float-window { position: absolute; left: 0px; }

.wps-component-float-window.unvisible { display: none; }

