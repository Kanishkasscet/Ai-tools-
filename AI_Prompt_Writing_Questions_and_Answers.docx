[dir="rtl"] .kd-button-group .kd-button:last-child { margin-left: 0px; border-radius: var(--kd-border-radius-middle) 0 0 var(--kd-border-radius-middle); }

[dir="rtl"] .kd-button-group.no-split .kd-button { margin-left: 0px; }

[dir="rtl"] .kd-button-group.no-split .kd-button-mid { border-left-width: medium; border-left-style: none; border-left-color: currentcolor; border-right-width: medium; border-right-style: none; border-right-color: currentcolor; }

[dir="rtl"] .kd-button-group.no-split .kd-button:first-child { border-right: 1px solid var(--kd-color-line-regular); border-left: 0px; }

