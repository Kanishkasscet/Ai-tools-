.kd-modal-root .kd-modal { position: fixed; z-index: var(--kd-z-index-dialog); width: 480px; }

.kd-modal-root .kd-modal-content { padding: 10px 16px 16px; color: var(--kd-color-text-primary); background: var(--kd-color-background-plate); border: 1px solid var(--kd-color-line-regular); border-radius: var(--kd-border-radius-extra-large); box-shadow: var(--kd-box-shadow-large); box-sizing: border-box; }

.kd-modal-root .kd-modal.draggable .kd-modal-header { cursor: move; }

.kd-modal-root .kd-modal-header { display: flex; padding: 0px 12px 10px 16px; margin: 0px -16px; justify-content: space-between; }

[dir="rtl"] .kd-modal-root .kd-modal-header { padding: 0px 16px 10px 12px; }

