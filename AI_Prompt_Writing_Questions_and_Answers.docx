.component-slider .slider-bar-wrap { position: relative; height: 41px; padding-bottom: 12px; display: flex; align-items: center; }

.component-slider .slider-bar-wrap .slider-bar { flex-grow: 1; background: rgb(220, 220, 220); height: 3px; border-radius: 3px; }

.component-slider .slider-bar-wrap .slider-progress { position: absolute; left: 0px; top: 13px; height: 3px; border-radius: 3px; background: rgb(65, 127, 249); }

.component-slider .slider-bar-wrap .slider-thumb { position: absolute; left: 0px; top: 5px; width: 18px; height: 18px; background: rgb(255, 255, 255); border-radius: 50%; box-shadow: rgba(0, 0, 0, 0.08) 0px 2px 3px 0px; }

.component-slider .slider-bar-wrap .slider-thumb.active, .component-slider .slider-bar-wrap .slider-thumb:active { background: rgb(233, 236, 240); }

.component-slider .slider-bar-wrap .slider-thumb::after { position: absolute; content: ""; inset: -10px; }

.theme-d .component-slider .slider-progress, .theme-s .component-slider .slider-progress { background: var(--kd-color-brand-normal); }

.theme-w .component-slider .slider-progress { background: rgb(73, 145, 242); }

.theme-p .component-slider .slider-progress { background: rgb(244, 109, 67); }

.theme-f .component-slider .slider-progress { background: rgb(235, 84, 81); }

